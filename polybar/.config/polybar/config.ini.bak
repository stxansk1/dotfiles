[colors]
background = #1e222a
background-alt = #282c34
foreground = #dfdfe0
primary = #b8bb26
alert = #fb4934
disabled = #707880

[bar/main]
width = 100%
height = 24pt
radius = 0

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 3pt

padding-left = 2
padding-right = 2
module-margin = 1

separator = " | "
separator-foreground = ${colors.disabled}

# Подставь свои шрифты, если этих нет (но JetBrains Mono обычно база)
font-0 = "JetBrains Mono:size=10;2"
font-1 = "JetBrainsMono Nerd Font:size=10;2"

modules-left = bspwm
modules-center = date
modules-right = xkeyboard  cpu memory pulseaudio wlan battery

wm-restack = bspwm

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true

[module/bspwm]
type = internal/bspwm
pin-workspaces = true
inline-mode = false
enable-click = true
enable-scroll = false

label-focused = %name%
label-focused-background = ${colors.background-alt}
label-focused-underline= ${colors.primary}
label-focused-padding = 2

label-occupied = %name%
label-occupied-padding = 2

label-urgent = %name%
label-urgent-background = ${colors.alert}
label-urgent-padding = 2

label-empty = %name%
label-empty-foreground = ${colors.disabled}
label-empty-padding = 2

[module/pulseaudio]
type = internal/pulseaudio

; Сборка модуля: сначала иконка громкости, потом проценты
format-volume = <ramp-volume> <label-volume>
label-volume = %percentage%%

; Что показывать, если звук выключен
label-muted = 󰝟 MUTED
label-muted-foreground = ${colors.disabled}

; Иконки из Nerd Font (тихо -> среднее -> громко)
ramp-volume-0 = 󰕿
ramp-volume-1 = 󰖀
ramp-volume-2 = 󰕾
ramp-volume-foreground = ${colors.primary}

use-ui-max = false
click-right = pavucontrol &

[module/memory]
type = internal/memory
interval = 2

; Добавляем иконку перед процентами
format-prefix = "󰘚 "
format-prefix-foreground = ${colors.primary}
label = %percentage_used:2%%

[module/cpu]
type = internal/cpu
interval = 2
format-prefix = " "
format-prefix-foreground = ${colors.primary}
label = %percentage:2%%

[module/wlan]
type = internal/network
interface-type = wireless
interval = 3.0

; Иконка для сети
format-connected = <ramp-signal> <label-connected>
label-connected = %essid%
label-connected-foreground = ${colors.foreground}

; Иконка если нет сети
format-disconnected = <label-disconnected>
label-disconnected =  OFF
label-disconnected-foreground = ${colors.disabled}

; Шкала сигнала (иконки будут меняться от силы сигнала)
ramp-signal-0 = 
ramp-signal-1 = 
ramp-signal-2 = 
ramp-signal-3 = 
ramp-signal-4 = 
ramp-signal-foreground = ${colors.primary}

[module/battery]
type = internal/battery
full-at = 99
low-at = 5

; На 95% ноутов это BAT0 и AC. Если вдруг не покажет инфу, напиши мне
battery = BAT1
adapter = AC
poll-interval = 5

; Форматы отображения при разрядке и зарядке
format-charging = <animation-charging> <label-charging>
format-discharging = <ramp-capacity> <label-discharging>

label-charging = %percentage%%
label-discharging = %percentage%%

label-full =  %percentage%%
label-low =  %percentage%%

; Иконки когда ноут разряжается
ramp-capacity-0 = 
ramp-capacity-1 = 
ramp-capacity-2 = 
ramp-capacity-3 = 
ramp-capacity-4 = 
ramp-capacity-foreground = ${colors.primary}

; Анимация иконок, когда идет зарядка
animation-charging-0 = 
animation-charging-1 = 
animation-charging-2 = 
animation-charging-3 = 
animation-charging-4 = 
animation-charging-foreground = ${colors.primary}
animation-charging-framerate = 750

[module/date]
type = internal/date
interval = 1
date = %H:%M
label = %date%
label-foreground = ${colors.primary}
date-alt = %a %d.%m.%Y  %H:%M

[module/xkeyboard]
type = internal/xkeyboard
blacklist-0 = num lock
blacklist-1 = scroll lock
blacklist-2 = caps lock
format = <label-layout>
format-prefix = "KB "
format-prefix-foreground = ${colors.primary}
label-layout = %layout%

[settings]
screenchange-reload = true
pseudo-transparency = true
